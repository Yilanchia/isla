{
  "name": "@isla/life",
  "version": "0.1.0",
  "description": "The life kernel: a heartbeat, an append-only life log, drives, sleep, feelings and grounded speech.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
