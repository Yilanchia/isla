    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@isla/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "typescript": "^5.8.3"
  }
}
