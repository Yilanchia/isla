{
  "name": "@isla/store-sqlite",
  "version": "0.1.0",
  "description": "SQLite storage adapter for Isla, built on node:sqlite.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@isla/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "typescript": "^5.8.3"
  }
}
