# Copy to .env and adjust. Everything here is optional: with no configuration,
# Isla runs offline with the deterministic demo provider.

# demo | openai | deepseek | ollama | lmstudio | openai-compatible
ISLA_PROVIDER=demo

# For hosted providers.
# ISLA_API_KEY=sk-...
# ISLA_MODEL=deepseek-chat
# ISLA_BASE_URL=https://api.deepseek.com/v1

# Optional: enables semantic memory. Without it the runtime uses local hashed vectors.
# ISLA_EMBEDDING_MODEL=text-embedding-3-small

PORT=8790
# ISLA_DATA_PATH=./data/isla.sqlite
# companion (neutral example) | isla (optional homage example)
# ISLA_PERSONA=companion
